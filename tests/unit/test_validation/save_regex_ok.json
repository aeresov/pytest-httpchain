{
    "stages": [
        {
            "name": "page",
            "request": { "url": "https://x.test/form" },
            "response": [
                { "save": { "regex": { "csrf": "name=\"csrf\" value=\"([^\"]+)\"", "ids": { "pattern": "id=(\\d+)", "all": true } } } },
                { "save": { "regex": { "order_id": { "pattern": "Order #(?P<id>\\d+) for {{ csrf }}", "group": "id" } } } },
                { "verify": { "expressions": [ "{{ len(ids) > 0 and order_id != '' }}" ] } }
            ]
        },
        {
            "name": "submit",
            "request": { "url": "https://x.test/submit", "method": "POST", "headers": { "X-CSRF-Token": "{{ csrf }}" } },
            "response": [ { "verify": { "status": 200 } } ]
        }
    ]
}
