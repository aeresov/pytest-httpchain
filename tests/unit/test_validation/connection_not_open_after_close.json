{
    "connections": {
        "dev": {
            "adapter": "userfuncs:GoodAdapter",
            "params": {
                "host": "localhost"
            }
        }
    },
    "stages": [
        {
            "name": "hello",
            "connection": {
                "name": "dev",
                "open": true
            }
        },
        {
            "name": "bye",
            "connection": {
                "name": "dev",
                "send": {
                    "op": "bye"
                },
                "close": true
            }
        },
        {
            "name": "late",
            "connection": {
                "name": "dev",
                "send": {
                    "op": "ping"
                }
            }
        }
    ]
}
