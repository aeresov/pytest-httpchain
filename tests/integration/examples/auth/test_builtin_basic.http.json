{
    "description": "Scenario-level basic auth from substitutions, and a stage that opts out of it",
    "substitutions": [{ "vars": { "password": "pass" } }],
    "auth": { "basic": { "username": "user", "password": "{{ password }}" } },
    "stages": [
        {
            "name": "authenticated",
            "fixtures": ["server"],
            "request": { "url": "{{ server }}/answer" },
            "response": [{ "verify": { "status": 200 } }]
        },
        {
            "name": "opted_out",
            "description": "auth: false sends no credentials at all: the client's auth is not applied",
            "fixtures": ["server"],
            "request": { "url": "{{ server }}/answer", "auth": false },
            "response": [{ "verify": { "status": 401 } }]
        },
        {
            "name": "authenticated_again",
            "description": "The opt-out is that stage's alone",
            "fixtures": ["server"],
            "request": { "url": "{{ server }}/answer" },
            "response": [{ "verify": { "status": 200 } }]
        }
    ]
}
